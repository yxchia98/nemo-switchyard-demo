# ---------------------------------------------------------------------------
# Switchyard Lab UI - server-side configuration
# Copy to .env.local before running `npm run dev`.
# These values are read ONLY inside app/api/* route handlers (server side).
# ---------------------------------------------------------------------------

# Where switchyard-server is listening.
# Matches: switchyard-server --config routes.toml --host 127.0.0.1 --port 4000
SWITCHYARD_BASE_URL=http://127.0.0.1:4000

# switchyard-server does not require client auth by default, so leave blank.
# Set it only if you put the router behind a gateway that expects a bearer token.
SWITCHYARD_API_KEY=

# Ask the router to include a usage block in the final streaming chunk.
# If your build rejects `stream_options`, the proxy automatically retries
# without it - set to 0 to skip the first attempt entirely.
SWITCHYARD_STREAM_USAGE=1

# Request timeout in milliseconds for a single chat completion.
SWITCHYARD_TIMEOUT_MS=180000
