# Switchyard runtime configuration.
# Copy to .env, fill in, and keep .env out of version control.
#
# IMPORTANT: do not quote values. `docker run --env-file` treats everything
# after the "=" literally, so OPENROUTER_API_KEY="sk-or-x" would include the
# quote characters in the key itself.

# ---- Efficient tier: OpenRouter free Nemotron 3.5 Lightning ----------------
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# ---- Capable tier: your self-hosted NIM ------------------------------------
NIM_BASE_URL=http://nim:8000/v1
NIM_MODEL=nvidia/nemotron-3-ultra
# Most self-hosted NIMs don't enforce auth; leave as EMPTY if so.
NIM_API_KEY=EMPTY

# ---- Stage router tuning ---------------------------------------------------
SWITCHYARD_ROUTE_ID=switchyard/stage
# efficient_first favours cost; capable_first favours quality.
SWITCHYARD_PICKER=efficient_first
SWITCHYARD_CONFIDENCE_THRESHOLD=0.5
SWITCHYARD_RECENT_WINDOW=3

# ---- Server ----------------------------------------------------------------
SWITCHYARD_HOST=0.0.0.0
SWITCHYARD_PORT=4000
RUST_LOG=info

NGC_API_KEY=nvapi-replace-me
